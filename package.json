{
  "name": "tftvn",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @tftvn/web dev",
    "build": "pnpm --filter @tftvn/web build",
    "test": "playwright test",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:check": "pnpm --filter @tftvn/db check",
    "db:migrate": "pnpm --filter @tftvn/db migrate",
    "db:pull": "pnpm --filter @tftvn/db pull",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "etl": "pnpm --filter @tftvn/etl run",
    "e2e": "playwright test -c playwright.e2e.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  }
}
