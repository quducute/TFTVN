{
  "name": "@tftvn/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "scripts": {
    "check": "node --env-file=../../.env.local check.mjs ../../migrations/0001_init.sql",
    "migrate": "node --env-file=../../.env.local migrate.mjs",
    "pull": "drizzle-kit pull && node postpull.mjs && prettier --write src/generated",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
